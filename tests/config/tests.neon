services:
	- Latte\Engine

extensions:
	mailino: Varhall\Mailino\DI\MailinoExtension

mailino:
	template_dir: %fixturesDir%/templates
	from:
		email: 'sender@test.com'
		name: 'Sender'
	reply_to:
		email: 'noreply@test.com'
		name: 'No Reply'
	return_path: 'bounce@test.com'
	priority: 3
	headers:
		X-Custom: 'test-value'
	extensions:
		prefix:
			subject: 'TST'

		mjml.api:
			id: '123456'
			secret: '654321'
			url: 'https://mjml.local/v1'

		mjml.binary:
			binary: 'none'
