{
	"name": "varhall/mailino",
	"type": "library",
	"description": "Varhall email library",
	"keywords": ["nette", "emails", "messages"],
	"homepage": "https://github.com/varhall/mailino",
	"license": "MIT",
        "authors": [
		{
			"name": "Ondrej Sibrava",
			"homepage": "https://www.varhall.cz"
		}
	],
	"support": {
		"issues": "https://github.com/varhall/mailino"
	},

	"require": {
		"php": ">=8.2",
		"latte/latte": "^3.0",
		"nette/mail": "^4.0",
		"nette/di": "^3.2",
		"nette/schema": "^1.2",
		"nette/utils": "^4.0"
	},

	"suggest": {
		"ext-curl": "Rendering MJML using MJML API (MjmlApi extension)",
		"nette/http": "Attachments created from uploaded files (Nette\\Http\\FileUpload)",
		"nette/application": "Use application Latte factory (translator, filters) via NetteLatteEngineFactory"
	},

	"require-dev": {
		"ninjify/nunjuck": "^v0.4",
		"squizlabs/php_codesniffer": "^3.13",
		"mockery/mockery": "^1.6",
		"nette/bootstrap": "^v3.2",
		"nette/application": "^3.2",
		"phpstan/phpstan": "^2.1"
	},

	"autoload": {
		"psr-4": {
			"Varhall\\Mailino\\": "src/"
		}
	},

	"extra": {
		"branch-alias": {
			"dev-master": "2.x-dev"
		}
	}
}
